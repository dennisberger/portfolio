---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Base from '@/layouts/Base.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import StatBar from '@/components/StatBar.astro';
import Stamp from '@/components/Stamp.astro';
import EditorialNumbers from '@/components/EditorialNumbers.astro';
import ClosingCTA from '@/components/ClosingCTA.astro';
import {
  SITE_URL,
  personEntity,
  websiteEntity,
  articleEntity,
  breadcrumbEntity,
  schemaGraph,
} from '@/lib/schema';

// Per-study closing CTA copy. Default (home) stays generic-but-good.
const closingBySlug: Record<string, { heading: string; text: string }> = {
  'taco-bell-designops': {
    heading: 'Scaling design ops from zero?',
    text: "I've done the agency-to-FTE grind and the governance fight. Compare notes.",
  },
  'gsk-analytics': {
    heading: 'Moving a SUS score is hard work.',
    text: "If you're fighting for UX evidence inside an enterprise, I'd like to hear how it's going.",
  },
  'effectv-ad-platform': {
    heading: 'Language is a UX lever.',
    text: "Most teams don't treat it that way. If yours does, let's talk.",
  },
  'comcast-ux-coe': {
    heading: "Consulting hours don't scale. Service tiers do.",
    text: "If you're spread too thin across too many teams, compare notes.",
  },
};

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map(s => ({
    params: { slug: s.data.slug },
    props: { study: s },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const { data } = study;

// Reading-time kicker: count words in the raw MDX body (minus frontmatter,
// imports, and JSX tags), then apply ~225 wpm. Magazine contents-page vibe.
const mdxPath = path.join(process.cwd(), 'src/content/case-studies', `${data.slug}.mdx`);
const raw = fs.readFileSync(mdxPath, 'utf8');
const body = raw
  .replace(/^---[\s\S]*?---\s*/m, '')        // strip frontmatter
  .replace(/^import\s+.+from\s+.+;$/gm, '')  // strip MDX imports
  .replace(/<[^>]+>/g, ' ')                  // strip HTML/JSX tags
  .replace(/[#*_`>]/g, ' ');                 // strip markdown syntax
const wordCount = body.trim().split(/\s+/).filter(w => w.length > 0).length;
const readMinutes = Math.max(1, Math.round(wordCount / 225));

// Flagship-only: editorial coda for Taco Bell.
// Entries here should *not* duplicate the top StatBar — this is additional proof,
// not a restatement of the hero numbers.
const byTheNumbers =
  data.slug === 'taco-bell-designops'
    ? [
        {
          value: '60+',
          lead: 'Components shipped and governed in the design system.',
          body: 'Not my hands on the components themselves. The system around them: dedicated workflow, triage and governance rituals, documentation support, tooling upgrades, and visibility into progress and constraints. The kind of infrastructure that lets a system keep growing past its first release.',
        },
        {
          value: 'Three',
          lead: 'IC tracks I leveled and codified, still in use today.',
          body: 'Lead, Senior, and on-level Product Designer. The framework underwrites every FTE hire and every contractor brought in through Insight Global. Same JDs we used to source the first internal team, still applied as the team expands.',
        },
        {
          value: '33%',
          lead: 'Research capacity expansion, January 2026.',
          body: 'Demand had grown past the original operating model. Negotiated the expansion to keep pace with product, marketing, and in-restaurant workstreams, without loosening intake or adoption discipline.',
        },
      ]
    : null;

// All other case studies, in canonical order, to surface at the end of each study.
const all = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const others = all.filter(s => s.data.slug !== data.slug);

const studyUrl = `${SITE_URL}/work/${data.slug}/`;
const jsonLd = schemaGraph([
  personEntity(),
  websiteEntity(),
  articleEntity({
    url: studyUrl,
    headline: data.title,
    description: data.excerpt,
    datePublished: data.publishedAt,
    dateModified: data.updatedAt,
    image: `${SITE_URL}/og-image.png`,
  }),
  breadcrumbEntity([
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Work', url: `${SITE_URL}/work/` },
    { name: data.title, url: studyUrl },
  ]),
]);
---

<Base
  title={data.title}
  description={data.excerpt}
  ogImage={`/og/${data.slug}.png`}
  ogType="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  jsonLd={jsonLd}
>
  <article class="study">
    {/* Lives INSIDE .study on purpose. A named view timeline is only
        resolvable from the declaring element and its descendants — not from
        a sibling in either direction (verified in the browser, not assumed).
        Move this out and the bar silently sticks at 100%. It is
        position: fixed and .study creates no containing block, so nesting it
        costs nothing. */}
    <div class="read-progress" aria-hidden="true"></div>
    <header class="study__header page">
      <a href="/work/" class="study__back">← All work</a>
      <SectionLabel>{data.tag} · {readMinutes} min read · {wordCount.toLocaleString()} words</SectionLabel>
      <h1 class="study__title">{data.title}</h1>
      {data.lede && (
        <p class="study__lede"><em>{data.lede}</em></p>
      )}
    </header>

    <div class="study__stats page">
      <StatBar stats={data.stats} />
    </div>

    <div class="study__body">
      <div class="prose">
        <Content />
      </div>

      {byTheNumbers && (
        <div class="prose prose--wide">
          <SectionLabel as="h2" id="by-the-numbers">Also worth noting</SectionLabel>
          <EditorialNumbers entries={byTheNumbers} />
        </div>
      )}
    </div>

    <div class="study__endmark">
      {data.closer && <p class="study__epigraph">{data.closer}</p>}
      <Stamp size={140} />
    </div>

    {others.length > 0 && (
      <nav class="study__more page" aria-labelledby="other-studies">
        <SectionLabel as="h2" id="other-studies">Other case studies</SectionLabel>
        <ol class="study__more-list">
          {others.map(s => (
            <li class="study__more-item">
              <a href={`/work/${s.data.slug}/`} class="study__more-link">
                <span class="study__more-tag">{s.data.tag}</span>
                <h3 class="study__more-title">{s.data.title}</h3>
                <span aria-hidden="true" class="study__more-arrow">→</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <ClosingCTA
      variant="continuation"
      heading={closingBySlug[data.slug]?.heading}
      text={closingBySlug[data.slug]?.text}
    />
  </article>
</Base>

<script is:inline>
  // Enter animation for paired figures — fade + 10px rise, staggered 120ms.
  // One-shot (unobserve on first intersection) so backscrolling doesn't replay.
  (function () {
    var pairs = document.querySelectorAll('figure.case-figure--pair');
    if (!pairs.length || !('IntersectionObserver' in window)) {
      pairs.forEach(function (f) { f.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    pairs.forEach(function (f) { io.observe(f); });
  })();
</script>

<style>
  .study { padding-top: var(--space-section); }

  /* Reading-progress hairline — fixed at the very top of the viewport, above
     the nav. Grows a fuchsia line from left to right as the reader scrolls
     through the article. Invisible at 0% (no background rule on purpose). */
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 100;
    pointer-events: none;
  }
  .read-progress::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--color-fuchsia);
  }

  /* Scroll-driven, so the bar tracks scroll position on the compositor with
     no main-thread work and no listener. The range is an exact restatement of
     the handler this replaced: `contain 0%` is the article's top edge at the
     viewport top, `contain 100%` is its bottom edge at the viewport bottom.
     Guarded by @supports — without scroll-driven animations the bar simply
     never fills, which is why it carries no background rule of its own. */
  @supports (animation-timeline: view()) {
    .study {
      view-timeline-name: --study-progress;
    }
    .read-progress::after {
      animation: read-progress-fill linear both;
      animation-timeline: --study-progress;
      animation-range: contain 0% contain 100%;
    }
  }

  @keyframes read-progress-fill {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .study__header {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--col-total);
  }
  .study__back {
    display: block;
    width: fit-content;
    margin-block-end: var(--space-xl);
    font-family: var(--font-body);
    font-size: var(--type-sm);
    text-decoration: none;
    color: var(--color-ink-muted);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .study__back:is(:hover, :focus-visible) { color: var(--color-fuchsia-deep); }

  .study__title {
    font-size: var(--type-4xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-block: var(--space-md) var(--space-lg);
    max-width: 18ch;
  }
  .study__lede {
    font-family: var(--font-display);
    font-size: var(--type-xl);
    line-height: var(--leading-snug);
    color: var(--color-fuchsia-deep);
    max-width: 40ch;
    margin-block-end: var(--space-lg);
  }
  .study__stats { padding-block-end: var(--space-section-sm); max-width: var(--col-total); }

  .study__body {
    padding-inline: var(--page-padding);
    padding-block: var(--space-section);
    max-width: var(--page-max);
    margin-inline: auto;
    /* The query container for the margin-note gutter. Its inline size is the
       real constraint — how much room the page has for prose plus gutter —
       where the viewport width was only a proxy for it. See .gutter-aside in
       global.css. */
    container-type: inline-size;
    container-name: reading-column;
  }

  .prose {
    max-width: var(--col-main);
    margin-inline: 0;
    font-family: var(--font-body);
    font-size: var(--type-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-ink);
    position: relative;
  }
  .prose--wide { max-width: var(--col-total); margin-block-start: var(--space-section); }

  /* MDX prose styling */
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--type-2xl);
    margin-block: var(--space-2xl) var(--space-md);
    max-width: 24ch;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: var(--type-xl);
    margin-block: var(--space-xl) var(--space-sm);
  }
  .prose :global(p) {
    margin-block-end: var(--space-lg);
    max-width: 38rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-block-end: var(--space-lg);
    padding-inline-start: var(--space-lg);
  }
  .prose :global(li) { margin-block-end: var(--space-xs); }
  .prose :global(strong) { font-weight: 600; color: var(--color-ink); }
  .prose :global(em) { font-style: italic; }
  .prose :global(blockquote) {
    margin-block: var(--space-2xl);
    padding: var(--space-lg) 0 var(--space-lg) var(--space-xl);
    border: 0;
    border-inline-start: 1px solid var(--color-fuchsia);
    background: transparent;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: var(--type-2xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-ink);
    max-width: var(--col-main);
  }
  .prose :global(blockquote p) { max-width: none; margin-block-end: var(--space-md); }
  .prose :global(blockquote p:last-child) { margin-block-end: 0; }

  /* Case study figures — product screenshots, device frames, diagrams. */
  .prose :global(figure.case-figure) {
    margin-block: var(--space-2xl);
    padding: 0;
    max-width: var(--col-main);
  }
  .prose :global(figure.case-figure img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    background: var(--color-paper-sunken);
    /* 1px hairline — almost invisible on paper, separates bright
       screenshots from dark paper in dark mode. */
    border: 1px solid var(--color-rule);
  }
  .prose :global(figure.case-figure--pair) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }
  /* Pair figures are for full-bleed, frameless screenshots — the image IS the
     composition. Override the single-figure frame + sunken backdrop so they
     sit seamlessly on paper. */
  .prose :global(figure.case-figure--pair > img) {
    width: 100%;
    height: auto;
    border: 0;
    background: transparent;
    /* Enter animation — settled by IntersectionObserver adding .is-visible */
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 520ms ease-out, transform 520ms ease-out;
  }
  .prose :global(figure.case-figure--pair > img:nth-of-type(2)) {
    transition-delay: 120ms;
  }
  .prose :global(figure.case-figure--pair.is-visible > img) {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .prose :global(figure.case-figure--pair > img) {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
  .prose :global(figure.case-figure figcaption) {
    grid-column: 1 / -1;
    margin-top: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--type-xs);
    color: var(--color-ink-muted);
    font-style: italic;
    max-width: 48ch;
  }
  @media (min-width: 640px) {
    .prose :global(figure.case-figure--pair) {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
    }
  }

  /* Desktop: widen prose container to accommodate floated margin notes in the gutter */
  @container reading-column (min-width: 57rem) {
    .prose {
      max-width: var(--col-total);
      padding-right: calc(var(--col-gutter) + var(--col-gap));
    }
    .prose :global(p),
    .prose :global(h2),
    .prose :global(h3),
    .prose :global(ul),
    .prose :global(ol) {
      max-width: var(--col-main);
    }
  }

  .study__endmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-section);
    text-align: center;
  }
  .study__epigraph {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: var(--type-xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-fuchsia-deep);
    max-width: 36ch;
    margin: 0;
  }

  .study__more {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-rule);
  }
  .study__more-list {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0 0;
  }
  .study__more-item {
    border-top: 1px solid var(--color-rule);
  }
  .study__more-item:last-child {
    border-bottom: 1px solid var(--color-rule);
  }
  .study__more-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    text-decoration: none;
    padding-block: var(--space-lg);
  }
  .study__more-tag {
    font-family: var(--font-body);
    font-size: var(--type-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt-deep);
    flex: 0 0 auto;
    min-width: 10rem;
  }
  .study__more-title {
    font-family: var(--font-display);
    font-size: var(--type-2xl);
    /* Restated so the <h3> renders exactly as the <span> it replaced. */
    font-weight: 400;
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-normal);
    text-wrap: auto;
    color: var(--color-ink);
    flex: 1;
  }
  .study__more-link:is(:hover, :focus-visible) .study__more-title { color: var(--color-fuchsia-deep); }
  .study__more-arrow {
    font-family: var(--font-display);
    color: var(--color-fuchsia);
    font-size: var(--type-2xl);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .study__more-link:is(:hover, :focus-visible) .study__more-arrow { transform: translateX(4px); }

  @media (max-width: 640px) {
    .study__more-link { flex-direction: column; align-items: flex-start; gap: var(--space-xs); padding-block: var(--space-md); }
    .study__more-tag { min-width: 0; }
  }
</style>
